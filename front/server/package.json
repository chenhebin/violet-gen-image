{
  "name": "yingyan-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:backend": "vite --mode backend",
    "build": "vue-tsc --noEmit && vite build",
    "build:backend": "vue-tsc --noEmit && vite build --mode backend",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@lucide/vue": "^1.0.0",
    "axios": "^1.18.1",
    "msw": "^2.15.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.40",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.10.1",
    "@types/postcss-pxtorem": "^6.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "postcss-pxtorem": "^6.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
