# Runtime
APP_ENV=development
HTTP_ADDR=:8080
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# PostgreSQL
DATABASE_URL=postgres://yingyan:yingyan_dev@127.0.0.1:5432/yingyan?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Private S3-compatible object storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=yingyan
MINIO_SECRET_KEY=yingyan_dev_secret
MINIO_BUCKET=yingyan-assets
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# Replace every value below before deploying.
ENCRYPTION_KEY=dev-encryption-key-change-me-32-bytes
TOKEN_PEPPER=dev-token-pepper-change-me
REDEMPTION_PEPPER=dev-redemption-pepper-change-me
BCRYPT_COST=12

# Cookie/session
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
USER_SESSION_COOKIE=yy_user_session
ADMIN_SESSION_COOKIE=yy_manage_session
USER_SESSION_TTL=24h
USER_REMEMBER_TTL=720h
ADMIN_SESSION_TTL=8h
ADMIN_REMEMBER_TTL=168h
TERMS_VERSION=v0.1

# Worker
WORKER_HEALTH_ADDR=:8081
WORKER_POLL_INTERVAL=1s
WORKER_STALE_AFTER=5m
WORKER_ID=local-worker

# AI provider outbound policy. Keep HTTP/private network disabled in production.
PROVIDER_ALLOW_HTTP=false
PROVIDER_ALLOW_PRIVATE_NETWORK=false
PROVIDER_CONNECT_TIMEOUT=10s
PROVIDER_REQUEST_TIMEOUT=180s
PROVIDER_RESPONSE_HEADER_TIMEOUT=180s

# 是否允许执行一次性的账号及演示数据初始化。
# 正常运行保持 false；仅在手动运行 seed 前临时改为 true，完成后立即改回 false。
ALLOW_ACCOUNT_SEED=false

# 平台管理员邮箱。该账号登录管理后台（Server），不能登录客户前端（Client）。
PLATFORM_ADMIN_EMAIL=

# 平台管理员初始密码，仅 bootstrap-admin 首次创建管理员时读取，长度为 12～72 字节。
# 创建成功后建议清空本项；修改这里不会自动修改数据库中已经存在的管理员密码。
PLATFORM_ADMIN_PASSWORD=

# 平台管理员显示名称，仅 bootstrap-admin 首次创建管理员时读取。
PLATFORM_ADMIN_NAME=平台管理员

# 客户前端用户邮箱。该账号登录客户前端（Client），不能登录管理后台（Server）。
CLIENT_USER_EMAIL=

# 客户前端用户密码，仅运行 seed 时读取，长度为 8～72 字节。
CLIENT_USER_PASSWORD=

# 修图管理员邮箱。该账号登录管理后台（Server），权限仅限修图工单相关功能。
RETOUCH_ADMIN_EMAIL=

# 修图管理员密码，仅运行 seed 时读取，长度为 8～72 字节。
RETOUCH_ADMIN_PASSWORD=

# Real provider E2E values are runtime-only and must not be committed.
# RUN_REAL_AI_TESTS=false
# E2E_AI_BASE_URL=
# E2E_AI_API_KEY=
# E2E_CHAT_MODEL=
# E2E_IMAGE_MODEL=
