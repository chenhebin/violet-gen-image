# Image names and release tag
IMAGE_TAG=0.1.0
BACKEND_IMAGE=yingyan-backend
CLIENT_IMAGE=yingyan-client
ADMIN_IMAGE=yingyan-admin

# HTTPS public address without a trailing slash.
PUBLIC_ORIGIN=

# Only the Client gateway is published. Keep 127.0.0.1 when a reverse proxy
# runs on the same host; use 0.0.0.0 only when the network design requires it.
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8088

# Use a URL-safe PostgreSQL password and put the same value in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# MinIO API stays private. Its console is available on host localhost only.
MINIO_ACCESS_KEY=yingyan
MINIO_SECRET_KEY=
MINIO_BUCKET=yingyan-assets
MINIO_REGION=us-east-1
MINIO_CONSOLE_PORT=9001

# Generate independent random values. Never reuse the database password.
ENCRYPTION_KEY=
TOKEN_PEPPER=
REDEMPTION_PEPPER=
BCRYPT_COST=12

# Leave blank for host-only cookies. Set only when subdomains must share them.
COOKIE_DOMAIN=
USER_SESSION_TTL=24h
USER_REMEMBER_TTL=720h
ADMIN_SESSION_TTL=8h
ADMIN_REMEMBER_TTL=168h
TERMS_VERSION=v0.1

# Worker and provider timeouts. WORKER_STALE_AFTER must exceed request timeout.
WORKER_ID=yingyan-worker-1
WORKER_POLL_INTERVAL=1s
WORKER_STALE_AFTER=5m
PROVIDER_CONNECT_TIMEOUT=10s
PROVIDER_REQUEST_TIMEOUT=180s
PROVIDER_RESPONSE_HEADER_TIMEOUT=180s
